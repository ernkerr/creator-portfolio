# ─── Required ──────────────────────────────────────────────────────────
# Edit these to rebrand your site. Copy this file to .env.local first.
NEXT_PUBLIC_SITE_URL=https://erinkerr.me
NEXT_PUBLIC_BRAND_NAME="ERIN KERR"
NEXT_PUBLIC_BRAND_TAGLINE="5+ years in content creation"
NEXT_PUBLIC_CONTACT_EMAIL=erin.kerr17@gmail.com

# ─── Featured nav link (optional) ──────────────────────────────────────
# Adds an external link to the header — like momi's "Creator Vault" slot.
# Leave blank to hide.
NEXT_PUBLIC_FEATURED_LABEL=Portfolio
NEXT_PUBLIC_FEATURED_URL=https://erinkerr.me

# ─── Socials (optional) ────────────────────────────────────────────────
# Username/handle only — URL is built in code. Leave blank to hide an icon.
# Order here matches render order in the Socials component.
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_TIKTOK=
NEXT_PUBLIC_YOUTUBE=
NEXT_PUBLIC_TWITTER=
NEXT_PUBLIC_BLUESKY=          # full handle, e.g. erin.bsky.social
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_GITHUB=ernkerr

# ─── Media (optional) ──────────────────────────────────────────────────
# Public base URL for your brand videos/posters. Use Cloudflare R2 (zero
# egress): create a bucket, enable r2.dev or attach a custom domain.
# Example: https://pub-<hash>.r2.dev  or  https://media.your-domain.com
NEXT_PUBLIC_R2_BASE_URL=

# ─── Analytics (optional) ──────────────────────────────────────────────
# GA4 Measurement ID (G-XXXXXXXXXX). Leave blank to disable.
NEXT_PUBLIC_GA_ID=

# ─── /admin passkey auth (server-only — NOT NEXT_PUBLIC) ───────────────
# Gates erin-codes.com/admin behind a passkey (Touch ID / Face ID).
#
# ADMIN_SESSION_SECRET  Signs the session cookie. Generate with:
#                         node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#                       Must be IDENTICAL here and in the brand-manager-web
#                       project (that app verifies the same cookie).
# ADMIN_BOOTSTRAP_SECRET  One-time code you type when enrolling a new device.
#                         Generate with:
#                         node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))"
# ADMIN_PASSKEYS  JSON array of enrolled credentials. Start as []. Enrolling a
#                 device (on /admin-access) prints the value to paste back here.
ADMIN_SESSION_SECRET=
ADMIN_BOOTSTRAP_SECRET=
ADMIN_PASSKEYS=[]

# ─── Tools waitlist (optional) ─────────────────────────────────────────
# Where the /tools "Join the waitlist" form POSTs. Use a Google Apps Script
# Web App that appends rows to a Google Sheet (no backend/database needed):
#   1. Create a Google Sheet with headers: name | email | tool | toolName
#   2. Extensions → Apps Script, paste a doPost(e) that appends e.parameter
#      to the sheet, then Deploy → New deployment → Web app
#      (Execute as: Me, Who has access: Anyone).
#   3. Paste the deployment URL below (ends in /exec).
# Leave blank during dev — the form still shows the success state (and logs
# the submission to the console) so you can build without it wired up.
NEXT_PUBLIC_WAITLIST_ENDPOINT=https://script.google.com/macros/s/PASTE_YOUR_DEPLOYMENT_ID/exec
